# === Environment ===
ENVIRONMENT=development          # development | production

# === LLM Configuration ===
# Primary provider & model
LLM_PROVIDER=openai              # Other existing providers remain supported
LLM_MODEL=gpt-4o-mini
LLM_REQUIRED=false               # Set true in production to disable mock fallback

# Model size routing (optional — agents pick large/small by role)
LLM_MODEL_LARGE=
LLM_MODEL_SMALL=
# LLM_MODEL_LARGE e.g. gpt-4o for teaching/planning agents
# LLM_MODEL_SMALL e.g. gpt-4o-mini for preference/scene agents

# Cloud provider API keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Provider-specific model overrides (optional — used by llm_integration_test.sh)
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# DEEPSEEK_MODEL=deepseek-chat
# OPENROUTER_MODEL=openai/gpt-4o-mini
# GEMINI_MODEL=gemini-2.0-flash
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Ollama (free local LLM — no API key needed) ---
# 1. Install Ollama: https://ollama.com
# 2. Pull a model:   ollama pull llama3.2:3b
# 3. Uncomment these two lines:
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2:3b
# For Docker deployment, use this URL so containers can reach your host:
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# For manual (non-Docker) setup:
OLLAMA_BASE_URL=http://localhost:11434

# Other local inference backends
VLLM_BASE_URL=http://localhost:8000/v1
LMSTUDIO_BASE_URL=http://localhost:1234/v1
TEXTGENWEBUI_BASE_URL=http://localhost:5000/v1

# Generic OpenAI-compatible endpoint
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_MODEL=

# --- LiteLLM (opt-in universal adapter — access 100+ LLM backends) ---
# Requires: pip install litellm
# USE_LITELLM=true
# LITELLM_MODEL=openai/gpt-4o       # Any litellm-supported model string
# LITELLM_API_BASE=                  # Optional: custom LiteLLM proxy URL
# LITELLM_API_KEY=                   # Optional: API key for LiteLLM proxy

# === Database ===
# Target: copy Supabase Connect's Session pooler URL (5432); URL-encode passwords.
# DATABASE_URL=postgresql+psycopg://postgres.YOUR_PROJECT:YOUR_ENCODED_PASSWORD@YOUR_POOLER_HOST:5432/postgres
# DATABASE_SSL_MODE=verify-full
# DATABASE_SSL_ROOT_CERT=/path/to/your-project-ca.crt
# DATABASE_POOL_MODE=session
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=5
# Local PostgreSQL (TLS disabled only locally):
# DATABASE_URL=postgresql+psycopg://opentutor:YOUR_PASSWORD@127.0.0.1:55432/opentutor
# DATABASE_SSL_MODE=disable
# LOCAL_POSTGRES_PASSWORD=YOUR_PASSWORD
# LOCAL_POSTGRES_PORT=55432
# Default local database path (no PostgreSQL required):
DATABASE_URL=sqlite+aiosqlite:///~/.opentutor/data.db
# You can also point to another SQLite file, for example:
# DATABASE_URL=sqlite+aiosqlite:///./tmp/opentutor-dev.db

# === Redis (optional for local dev) ===
# Only required when APP_RUN_SCHEDULER=true or APP_RUN_ACTIVITY_ENGINE=true
# Local dev works fine without Redis when both are off (the default)
REDIS_URL=redis://localhost:6379/0

# === Authentication ===
AUTH_ENABLED=false                    # Keep false for local/OpenClaw-style deployment
DEPLOYMENT_MODE=single_user           # Keep single_user for this project's default local mode
JWT_SECRET_KEY=change-me-in-production   # Ignored unless AUTH_ENABLED=true
AUTH_PROVIDER=local                   # Set supabase for target deployment
# Supabase Auth also requires AUTH_ENABLED=true and DEPLOYMENT_MODE=multi_user.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=documents
STORAGE_BACKEND=local                 # Set supabase for durable private documents
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.pptx,.ppt,.docx,.doc,.html,.htm,.txt,.md
ENCRYPTION_KEY=                       # Fernet key required in production

# === CORS ===
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001   # Comma-separated, or * for all

# === File Upload ===
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
SCRAPE_FIXTURE_DIR=

# === Runtime Bootstrap ===
APP_AUTO_CREATE_TABLES=true      # Auto-create DB tables on startup (set false if relying on alembic only)
APP_AUTO_SEED_SYSTEM=true        # Seed templates & preset scenes on first startup
APP_AUTO_SEED_DEMO=true         # Native setup sets false in its separate private settings
APP_RUN_SCHEDULER=false          # Enable APScheduler background jobs
APP_RUN_ACTIVITY_ENGINE=false    # Enable durable task execution engine

# === Code Sandbox ===
CODE_SANDBOX_BACKEND=auto        # auto (detect Docker/Podman, fall back to process) | container | process
CODE_SANDBOX_RUNTIME=docker      # docker | podman
CODE_SANDBOX_IMAGE=python:3.11-alpine
CODE_SANDBOX_TIMEOUT_SECONDS=5
ALLOW_INSECURE_PROCESS_SANDBOX=false  # Dev-only escape hatch; keep false for strict sandboxing

# Docker socket path (for code sandbox container backend)
# Linux/macOS: /var/run/docker.sock (default)
# Windows Docker Desktop: //./pipe/docker_engine
# Or set CODE_SANDBOX_BACKEND=process to avoid needing Docker socket
DOCKER_SOCK=/var/run/docker.sock

# === Rate Limiting ===
RATE_LIMIT_MODE=simple               # simple | cost_aware (GCRA with per-endpoint costs)
RATE_LIMIT_COST_BUDGET=500           # Cost units per minute per IP (cost_aware mode only)

# === 3-Tier Model Routing (optional — overrides LLM_MODEL_LARGE/SMALL) ===
LLM_MODEL_FAST=
LLM_MODEL_STANDARD=
LLM_MODEL_FRONTIER=
# LLM_MODEL_FAST e.g. gpt-4o-mini for greetings/preferences
# LLM_MODEL_STANDARD e.g. gpt-4o-mini for teaching/quiz
# LLM_MODEL_FRONTIER e.g. gpt-4o for planning/assessment/code

# === Swarm / Parallel Execution ===
SWARM_ENABLED=true
SWARM_MAX_CONCURRENCY=4
SWARM_TIMEOUT_SECONDS=30.0
SWARM_TOKEN_BUDGET=50000
PARALLEL_CONTEXT_LOADING=true
ACTIVITY_ENGINE_MAX_CONCURRENCY=3
ACTIVITY_USE_REDIS_NOTIFY=false

# === Server Ports (used by docker-compose and quickstart.sh) ===
# API_PORT=8000
# WEB_PORT=3001

# === Experimental Features (disabled by default) ===
ENABLE_EXPERIMENTAL_LOOM=false           # Knowledge graph (LOOM) — concept mastery, prerequisites, learning path
ENABLE_EXPERIMENTAL_LECTOR=false         # Semantic spaced review (LECTOR) — interference-aware review sessions
ENABLE_EXPERIMENTAL_CAT=false            # CAT adaptive diagnostic pretest — cold-start ability estimation
ENABLE_EXPERIMENTAL_BROWSER=false        # Browser automation — agent web search tool
ENABLE_EXPERIMENTAL_VISION=false         # Vision/LaTeX OCR — image analysis agent tool
ENABLE_EXPERIMENTAL_NOTION_EXPORT=false  # Notion export agent tool

# === Proxy ===
TRUST_PROXY_HEADERS=false          # Only enable behind a trusted reverse proxy (NGINX, Cloudflare, etc.)
